{
  "name": "ddongvoid",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "services": [
    { "binding": "MUSIC_ASSETS", "service": "ddongvoid-music-assets" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ddongvoid",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "SCORES", "class_name": "ScoreVerifier" },
      { "name": "PASSWORDS", "class_name": "AccountPasswords" },
      { "name": "LOBBY_CHAT", "class_name": "LobbyChat" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "ScoreVerifier"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountPasswords"] },
    { "tag": "v3", "new_sqlite_classes": ["LobbyChat"] }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CHAT_LIMIT", "namespace_id": "1002", "simple": { "limit": 8, "period": 10 } }
  ]
}
