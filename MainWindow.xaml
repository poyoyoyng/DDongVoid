<Window x:Class="DDongVoid.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DDongVoid" Title="AKC미니게임" Width="480" Height="740" MinWidth="480" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#EDF4F0" ResizeMode="CanResize" FontFamily="Malgun Gothic" PreviewKeyDown="Window_KeyDown" PreviewMouseLeftButtonDown="Window_MouseDown" Deactivated="Window_Deactivated">
  <Grid x:Name="WindowRoot" Margin="7">
    <Border x:Name="Shell" Background="#101B17" BorderBrush="#3B5044" BorderThickness="1" CornerRadius="16"/>
    <Grid Margin="1">
      <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="56"/><RowDefinition x:Name="HudRow" Height="88"/><RowDefinition Height="*"/><RowDefinition x:Name="FooterRow" Height="56"/></Grid.RowDefinitions>
      <Border x:Name="TitleChrome" Background="#F2182520" CornerRadius="15,15,0,0" MouseLeftButtonDown="Title_Drag">
        <Grid Margin="20,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Fill="#A7F3CE" Width="9" Height="9" Margin="0,0,10,0"/><TextBlock Text="AKC미니게임" FontWeight="Bold" FontSize="15"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="숨기기" Click="Hide_Click" ToolTip="Ctrl + Shift + Space로 숨기기 / 다시 표시" Padding="12,8" Background="Transparent"/>
            <Button Content="―" Click="Minimize_Click" ToolTip="최소화" Background="Transparent" Padding="12,8"/>
            <Button Content="✕" Click="Close_Click" ToolTip="닫기" Background="Transparent" Padding="12,8"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="HudChrome" Grid.Row="1" Background="#F2101B17" BorderBrush="#2B3C32" BorderThickness="0,0,0,1">
        <Grid Margin="24,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="SCORE" FontSize="10" Foreground="#91AB9C"/><TextBlock x:Name="ScoreText" Text="00000" FontFamily="Consolas" FontSize="32" FontWeight="Bold" Foreground="#A7F3CE"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="16,0,28,0" VerticalAlignment="Center"><TextBlock x:Name="BestText" Text="BEST  —" FontFamily="Consolas" FontSize="12" Foreground="#B7C6BE"/><TextBlock x:Name="TimeText" Text="00:00  ·  LV. 1" FontFamily="Consolas" FontSize="12" Foreground="#91AB9C" Margin="0,7,0,0"/></StackPanel>
          <Button x:Name="PauseButton" Grid.Column="2" Content="일시정지" Click="Pause_Click" IsEnabled="False" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <Grid Grid.Row="2" ClipToBounds="True">
        <local:GameSurface x:Name="Surface" Focusable="True"/>
        <TextBlock x:Name="ModeLabel" Text="01 / SURVIVE THE FALL" IsHitTestVisible="False" Foreground="#658572" FontFamily="Consolas" FontSize="11" Margin="24,18" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <TextBlock x:Name="QuietScore" Visibility="Collapsed" IsHitTestVisible="False" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="13" Margin="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Grid x:Name="Overlay" Background="#30101B17">
          <Border x:Name="Dialog" MaxWidth="430" Margin="22" Padding="28" CornerRadius="16" BorderBrush="#40574A" BorderThickness="1" Background="#FC18261F" HorizontalAlignment="Center" VerticalAlignment="Center" PreviewMouseLeftButtonDown="Dialog_Drag">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="0,-12,-12,10">
                <TextBlock Text="드래그해서 창 이동" FontSize="10" Foreground="#728F7D" VerticalAlignment="Center" Cursor="SizeAll" Margin="0,0,40,0"/>
                <Button Content="✕" Click="Close_Click" ToolTip="게임 종료" AutomationProperties.Name="게임 종료" Width="30" Height="30" Padding="0" FontSize="15" Background="Transparent" HorizontalAlignment="Right"/>
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="440"><StackPanel x:Name="DialogContent"/></ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Border x:Name="FooterChrome" Grid.Row="3" Background="#F2182520" CornerRadius="0,0,15,15" BorderBrush="#2B3C32" BorderThickness="0,1,0,0">
        <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="UserText" Text="GUEST · 기록을 남기려면 로그인" Foreground="#93AB9C" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="기록" Click="History_Click" Background="Transparent" Padding="11,9"/><Button x:Name="AccountButton" Content="로그인" Click="Account_Click" Background="Transparent" Padding="11,9"/><Button Content="설정" Click="Settings_Click" Background="Transparent" Padding="11,9"/></StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid x:Name="SizeModeLayer" Visibility="Collapsed" Background="#B3101B17" MouseLeftButtonDown="SizeMode_MouseDown" MouseMove="SizeMode_MouseMove">
      <Rectangle Stroke="#A7F3CE" StrokeThickness="2" StrokeDashArray="5 3" RadiusX="16" RadiusY="16" IsHitTestVisible="False"/>
      <Rectangle Width="14" Height="14" Fill="#A7F3CE" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
      <Rectangle Width="14" Height="14" Fill="#A7F3CE" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"/>
      <Rectangle Width="14" Height="14" Fill="#A7F3CE" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
      <Rectangle Width="14" Height="14" Fill="#A7F3CE" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
      <Rectangle Width="28" Height="6" Fill="#A7F3CE" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"/>
      <Rectangle Width="28" Height="6" Fill="#A7F3CE" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
      <Rectangle Width="6" Height="28" Fill="#A7F3CE" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <Rectangle Width="6" Height="28" Fill="#A7F3CE" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
        <TextBlock Text="WINDOW SIZE" FontSize="10" FontWeight="Bold" Foreground="#A7F3CE" HorizontalAlignment="Center" IsHitTestVisible="False"/>
        <TextBlock x:Name="SizeModeText" Text="480 × 740" FontFamily="Consolas" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,8" IsHitTestVisible="False"/>
        <TextBlock Text="테두리 · 모서리를 드래그해 가로 · 세로를 맞추세요.&#x0a;안쪽을 드래그하면 창을 옮깁니다.&#x0a;Enter 저장  ·  Esc 취소" FontSize="11" Foreground="#A8BCAF" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,14" IsHitTestVisible="False"/>
        <Button Content="이 크기로 저장" Click="SizeModeSave_Click" Style="{StaticResource Primary}" Margin="0,0,0,6"/>
        <Button Content="취소" Click="SizeModeCancel_Click"/>
      </StackPanel>
    </Grid>
    <Border Height="6" VerticalAlignment="Top" Margin="12,0" Background="#01000000" Cursor="SizeNS" Tag="12" MouseLeftButtonDown="Resize_Down"/>
    <Border Height="6" VerticalAlignment="Bottom" Margin="12,0" Background="#01000000" Cursor="SizeNS" Tag="15" MouseLeftButtonDown="Resize_Down"/>
    <Border Width="6" HorizontalAlignment="Left" Margin="0,12" Background="#01000000" Cursor="SizeWE" Tag="10" MouseLeftButtonDown="Resize_Down"/>
    <Border Width="6" HorizontalAlignment="Right" Margin="0,12" Background="#01000000" Cursor="SizeWE" Tag="11" MouseLeftButtonDown="Resize_Down"/>
    <Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#01000000" Cursor="SizeNWSE" Tag="13" MouseLeftButtonDown="Resize_Down"/>
    <Border Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#01000000" Cursor="SizeNESW" Tag="14" MouseLeftButtonDown="Resize_Down"/>
    <Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#01000000" Cursor="SizeNESW" Tag="16" MouseLeftButtonDown="Resize_Down"/>
    <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#01000000" Cursor="SizeNWSE" Tag="17" MouseLeftButtonDown="Resize_Down"><TextBlock x:Name="ResizeMarker" Text="◢" FontSize="11" Foreground="#698775" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Border>
  </Grid>
</Window>
