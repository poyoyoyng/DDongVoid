<Application x:Class="DDongVoid.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Dark defaults; Theme.Apply swaps these brushes for the light theme. -->
    <SolidColorBrush x:Key="Mint" Color="#A7F3CE"/>
    <SolidColorBrush x:Key="ButtonText" Color="#E9F1ED"/>
    <SolidColorBrush x:Key="ButtonFill" Color="#27332F"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#10291E"/>
    <SolidColorBrush x:Key="InputFill" Color="#101A16"/>
    <SolidColorBrush x:Key="InputText" Color="#EDF4F0"/>
    <SolidColorBrush x:Key="InputBorder" Color="#3A4C42"/>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Malgun Gothic"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource ButtonText}"/><Setter Property="Background" Value="{DynamicResource ButtonFill}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Mint}"/><Setter TargetName="Body" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Mint}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource InputFill}"/><Setter Property="Foreground" Value="{DynamicResource InputText}"/><Setter Property="CaretBrush" Value="{DynamicResource Mint}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="{DynamicResource InputFill}"/><Setter Property="Foreground" Value="{DynamicResource InputText}"/><Setter Property="CaretBrush" Value="{DynamicResource Mint}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource InputText}"/><Setter Property="Margin" Value="0,12"/><Setter Property="FontSize" Value="14"/></Style>
  </Application.Resources>
</Application>
